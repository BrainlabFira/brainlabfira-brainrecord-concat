# Copia este archivo a .env y rellena los valores.
# El .env está ignorado por git: es donde viven las credenciales reales.
#
#   cp .env.example .env
#
# docker-compose.yml lee MINIO_ACCESS_KEY, MINIO_SECRET_KEY, SUPABASE_URL,
# SUPABASE_ANON_KEY y ADMIN_ROLE_ID de aquí. El resto de variables las define
# el propio compose.

# ── MinIO ──
# Este servicio es el ÚNICO que tiene credenciales de MinIO: la app de
# escritorio sube por presigned URLs que pide a /upload-url.
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# ── Supabase ──
# Para validar los JWT de la app y mapear el email a numericUserId.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# role_id de public.users que puede listar y ver las grabaciones de TODOS.
# El resto de usuarios solo accede a su propia carpeta.
ADMIN_ROLE_ID=1

# ── Descarga del instalador ──
# Clave para GET /download?key=... , el enlace que se reparte a los empleados
# para instalar la app por primera vez. No sirve el JWT porque este solo existe
# DESPUÉS de instalar y hacer login.
# Sin esta variable, /download exige JWT y la primera instalación es imposible.
DOWNLOAD_KEY=

# ── Solo si ejecutas el servicio FUERA de Docker (npm start) ──
# Dentro de Docker estas vienen del docker-compose.yml.
# PORT=9200
# MINIO_ENDPOINT=192.168.1.175
# MINIO_PORT=9100
# MINIO_BUCKET=recordings
# MINIO_USE_SSL=false
# CONCAT_PREFIX=concatenated
# Ruta a ffmpeg si no está en el PATH (en local Windows, ej. C:\ffmpeg\bin\ffmpeg.exe)
# FFMPEG_PATH=ffmpeg
